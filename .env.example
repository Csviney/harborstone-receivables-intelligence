# Copy to .env and set real passwords.

# Postgres container. The admin role is only used by scripts/setup_db.sh.
POSTGRES_DB=harborstone
POSTGRES_USER=harborstone_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_HOST_PORT=5433

# App runtime role. setup_db.sh creates it from this URL.
DATABASE_URL=postgresql://harborstone_app:change-me-app@127.0.0.1:5433/harborstone

# Optional. Invoice assessment is disabled when unset.
OPENAI_API_KEY=
OPENAI_MODEL=
